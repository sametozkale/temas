# Copy to .env.local (git-ignored). See docs/02-architecture.md §4.

APP_URL=http://localhost:3000

# Database (local Supabase: `npm run supabase:start` prints these)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email. When RESEND_API_KEY is empty, mail goes to local Mailpit (UI http://127.0.0.1:54324).
RESEND_API_KEY=
EMAIL_FROM="Temas <noreply@temas.local>"
# Product feedback from the sidebar. Local Mailpit uses feedback@localhost if empty.
FEEDBACK_TO=
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Pub/Sub topic for Gmail users.watch. Empty = poll via Inngest cron.
GMAIL_PUBSUB_TOPIC=

# WhatsApp Business Cloud API (Meta)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Set to 1 to log every Drizzle query (N+1 scan helper)
DRIZZLE_LOG=
